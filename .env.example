# Qdrant Configuration
# Choose ONE of the following options:

# Option 1: Remote Qdrant Server (recommended for production)
QDRANT_URL=http://your-server-ip:6309

# Option 2: Local file-based Qdrant (for development/testing)
# QDRANT_PATH=./qdrant_storage

# =============================================================================
# Embedding Provider Configuration
# =============================================================================
# Choose your embedding provider: "openai", "voyage", or "nomic"
# Default: openai (backward compatible)
EMBEDDING_PROVIDER=openai

# -----------------------------------------------------------------------------
# Option 1: OpenAI (default)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-proj-your-api-key-here
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSION=1536

# -----------------------------------------------------------------------------
# Option 2: Voyage AI (Anthropic's recommended partner)
# +27% accuracy improvement over OpenAI, better for RAG
# Get API key: https://www.voyageai.com/
# -----------------------------------------------------------------------------
# EMBEDDING_PROVIDER=voyage
# VOYAGE_API_KEY=pa-your-voyage-api-key-here
# EMBEDDING_MODEL=voyage-3-large        # Best quality
# EMBEDDING_MODEL=voyage-3.5-lite       # Cost-effective alternative
# EMBEDDING_DIMENSION=1024              # Matryoshka: 256, 512, 1024, 2048

# -----------------------------------------------------------------------------
# Option 3: Nomic AI (open-source)
# Free self-hosted option, Apache 2.0 license
# Get API key: https://atlas.nomic.ai/
# -----------------------------------------------------------------------------
# EMBEDDING_PROVIDER=nomic
# NOMIC_API_KEY=your-nomic-api-key-here
# EMBEDDING_MODEL=nomic-embed-text-v2-moe
# EMBEDDING_DIMENSION=768

# =============================================================================
# MIGRATION NOTE
# =============================================================================
# Different embedding providers create INCOMPATIBLE vectors!
# If you switch providers, you must re-index all existing memories.
#
# To migrate:
# 1. Export all memories (use list_collections + batch_get_memories)
# 2. Delete old collections
# 3. Change EMBEDDING_PROVIDER
# 4. Re-import memories (they will be re-embedded with new provider)
